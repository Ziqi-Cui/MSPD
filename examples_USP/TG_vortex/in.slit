###########################################################
# Input script of flat flow Re=1000 Ma = 0.2
#
# Feng Kai 
# kfeng@buaa.edu.cn 
###########################################################

variable collision_style index usp 
shell			mkdir data
seed			    1234
dimension		2
global			gridcut -1 comm/sort yes 

boundary		o ro p

create_box		-3.7880 3.7880 0 3.7880 -0.5 0.5
create_grid		280 140 1

balance_grid		rcb cell

read_surf          data.slit  group solid  invert
#read_surf          data.slit_inv  group solid  
read_surf          data.slit_on  group outflow transparent  invert
read_surf          data.slit_mid  group mid transparent    invert
read_surf          data.slit_mid_inv  group mid transparent  invert

surf_collide   1 diffuse   273 1
surf_collide   2 transparent


surf_modify  solid collide 1
surf_modify  outflow collide 2
surf_modify  mid collide 2

species			ar.species Ar
mixture			air Ar nrho 1.0e20 vstream 0.0 0.0 0.0 temp 273

fix		   		left emit/face air xlo 
fix		   		hi emit/surf air outflow 

region			1 block -3.7880 0.0 0.0 3.7880 -0.5 0.5
#global			nrho 1.0e20
global			fnum 2.2420e15

create_particles	air n 2560000 region 1
#create_particles	air n 0


if "${collision_style}== dsmc" then &
  "collide			vss air ar.vss" &
else &
  "collide			bgk air ${collision_style} ar.bgk" &
  "collide_bgk_modify pr_num 0.66667 time_ave 0.999 reset_wmax 0.9999 "


stats			10
compute			1 grid all air nrho u v
compute			2 thermal/grid all air temp
compute		3 surf mid air mflux
stats_style		step cpu np


timestep 		1.7975e-4

run				200

fix				1 ave/grid all 1 200 200 c_1[*] c_2[*] ave running
fix				2 ave/surf mid 1 200 200 c_3[*] ave running

dump			1 grid all 200 data/slit_field.*.dat xc yc f_1[*]
dump			2 surf mid 200 data/mid_mflux.*.dat id f_2[*]

run 			200



