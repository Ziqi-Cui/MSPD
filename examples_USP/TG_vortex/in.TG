###########################################################
# Input script of lid-driven cavity flow Kn = 1 Re=0.268
#
# Feng Kai 
# kfeng@buaa.edu.cn 
###########################################################
shell			mkdir data
seed			    1234
dimension		2
global			gridcut -1 comm/sort yes 

boundary		p p p

create_box		0.0  1.0  0.0  1.0  -0.5 0.5
create_grid		80 80 1

balance_grid		rcb cell


species			ar.species Ar
mixture			air Ar vstream 0.0 0.0 0.0 temp 273

global			nrho  5.1869e20
global			fnum 3.2418e13

#collide             vss air ar.vss
collide			bgk air ufp ar.bgk
collide_bgk_modify pr_num 0.66667 time_ave 0 reset_wmax 0.9999
timestep 		 9.8553e-06

read_particles	TG_20.dat   0
#create_particles	air n 0

stats			10
compute			1 grid all air nrho u v
compute			2 thermal/grid all air temp
stats_style		step cpu np


#timestep 		3.9394e-05
#run 			362

#fix			1 ave/grid all 1 1 1 c_1[*] c_2[*] ave running
dump			1 grid all 362 data/TG_ufp.*.dat xc yc c_1[*] c_2[*]

run 			362


