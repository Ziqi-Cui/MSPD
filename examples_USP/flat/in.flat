###########################################################
# Input script of flat flow Kn = 0.000669 Re=10000
#
# Feng Kai 
# kfeng@buaa.edu.cn 
###########################################################

variable collision_style index usp 
shell			mkdir data
seed			    1234
dimension		2
global			gridcut -1 comm/sort yes 

boundary		o ro p

create_box		-0.2e-2 1.2857e-2 0 0.4e-2 -0.5 0.5
create_grid		50 40 1 levels 3 subset 2 5*50 1*10 * 2  4  1  subset 3  *  1*2  1  1  3  1 

balance_grid		rcb cell

read_surf          data.flat  group solid

surf_collide   1 diffuse   273 1
surf_modify  solid collide 1


write_grid	    data/finalgrid.dat



species			ar.species Ar
mixture			air Ar vstream 92.34 0.0 0.0 temp 273

global		    	temp 273 vstream 92.34 0.0 0.0
global			nrho 2.6895e25
global			fnum 7.9917e14

if "${collision_style}== dsmc" then &
  "collide			vss air ar.vss" &
else &
  "collide			bgk air ${collision_style} ar.bgk" &
  "collide_bgk_modify pr_num 0.66667 time_ave 0.999 reset_wmax 0.9999 "

create_particles	air n 0

stats			100
compute			1 grid all air nrho u v
compute			2 thermal/grid all air temp
stats_style		step cpu np


timestep 		1e-8
run 			1

#fix			1 ave/grid all 1 200 200 c_1[*] c_2[*] ave running
#dump			1 grid all 200 data/flat.*.dat xc yc f_1[*]

#run 			1



