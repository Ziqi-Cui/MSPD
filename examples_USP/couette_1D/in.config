# 2d flow around a circle

#------------------------Basic setting------------------------#

variable            xmin equal  -0.1   #������x����
variable            xmax equal  1
variable            ymin equal  0.0    #������y����
variable            ymax equal  0.4
variable            zmin equal -0.5
variable            zmax equal  0.5

variable            dx equal 1.83E-03  #x����߶�
variable            dy equal 1.33E-03  #y����߶�
variable            dz equal 1

variable            Nx equal (${xmax}-${xmin})/${dx}   #��ʼ������
variable            Ny equal (${ymax}-${ymin})/${dy}
variable            Nz equal (${zmax}-${zmin})/${dz}

variable            tWall       equal 1800.            #�����¶�
variable            nDens       equal 3.837620E+20     #���ܶ�
variable            nParPerCell equal 25

variable            vol          equal ${dx}*${dy}*${dz}               
variable            nRealPerCell equal ${nDens}*${vol}
variable            fnum         equal ${nRealPerCell}/${nParPerCell}

global              fnum ${fnum}
global              nrho ${nDens}
global              gridcut 2.67E-03 comm/sort yes 

seed	    	    12345
dimension   	    2         #��ά����

#------------------------2. Simulation setup------------------------#
#2.1. Computational domain and boundary condition

boundary	    o ro p  
create_box          ${xmin} ${xmax} ${ymin} ${ymax} ${zmin} ${zmax}
create_grid         ${Nx} ${Ny} ${Nz}
balance_grid        rcb cell

read_surf           data.asin group solid   #��������ļ���group����Ϊsolid

#2.2. Gas mixture
species             ar.species Ar
mixture             gas Ar temp 198.639 vstream 2625.6 0.0  0.0

#2.3. Collision model 
collide             vss gas ar.vss 

surf_collide        sc1 diffuse ${tWall} 1.0   #��ȫ������
surf_modify         solid collide sc1

#2.4. Initial condition

adapt_grid          all refine surf solid 5e-5 iterate 3 maxlevel 3 dir  0 -1 0  

timestep 	    9.69E-08

fix                 in1 emit/face gas xlo

stats          100
stats_style    step cpu spcpu np ncomm nexit ncoll nscoll maxlevel  

#------------------------3. Start running, and output data ------------------------#

compute                 Nden  grid all gas nrho
compute                 Therm thermal/grid all gas press temp
compute                 Mrho  grid all gas massrho
compute                 Speed grid all gas u v
compute                 Surf  surf solid gas n press shx  #x������Ӧ��

run			            5000

adapt_grid              all refine particle 50 50 iterate 5

run                     10000

adapt_grid              all refine particle 50 50 iterate 5
write_grid	            finalgrid.dat

run                     5000

fix                     Therm1 ave/grid all 1 6000 6000 c_Mrho[1] c_Therm[*]  ave running
fix                     Speed1 ave/grid all 1 6000 6000 c_Speed[*]   ave running
fix                     Surf1  ave/surf solid 1 6000 6000 c_Surf[*]  ave running

dump                    f1 grid all 6000 Therm*.plt xc yc f_Therm1[*]
dump                    f2 grid all 6000 Speed*.plt xc yc f_Speed1[*]
dump                    f3 surf solid 6000 Surf*.plt v1x v1y v2x v2y f_Surf1[*]

run                     12000

