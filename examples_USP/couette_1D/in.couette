###########################################################
# Input script of couette flow example 
# you can change collision ( or relaxtion ) mode by "collide"
# command below
#
# Feng Kai 
# kfeng@buaa.edu.cn 
###########################################################
seed			    12345
shell			mkdir data
dimension		2
global			gridcut -1.0 comm/sort yes 

boundary		p s p

create_box		0 1 0 6.3593e-06 -0.5 0.5
create_grid		1 200 1

balance_grid		rcb part

surf_collide		lo diffuse 273 1 translate 20 0 0
bound_modify		ylo collide lo

surf_collide		hi diffuse 273 1 translate -20 0 0
bound_modify		yhi collide hi
species			ar.species Ar
mixture			air Ar vstream 0.0 0.0 0.0 temp 273

global			nrho 2.6895e+25
global			fnum 2.8495e+15
# chose different command line to use different collision mode 
## DSMC  
#collide			vss air ar.vss
## ES-BGK 
#collide			bgk air esbgk ar.bgk 
## Shakhov-BGK  
#collide			bgk air sbgk ar.bgk 
## original BGK 
#collide			bgk air bgk ar.bgk 
## USP-BGK 
#collide			bgk air usp ar.bgk 
## ES-FP 
collide			bgk air ufp ar.bgk 

# collide_bgk_modify is a new command to set some parameter in BGK-like 
# method, can only be used when collide mode is bgk
#
# pr_num      global Prandtl Number 
# time_ave    set time-average coefficient of Calculation of Macro Quantity
#             e.g. <new> = <old> * time_ave + <current> * (1-time_ave)
# reset_wmax  whether and how to reduce Wmax in accept-reject method
#             if no W > Wmax this loop in this cell , Wmax *= reset_wmax 
#             ( {f_u = W * f_maxwell} in USP algorithm)
#collide_bgk_modify pr_num 0.6667 time_ave 0.99 reset_wmax 0.99 #0.66667

create_particles	air n 0

stats			1000
compute			1 grid all air massrho u 
compute			2 thermal/grid all air temp press
compute                                  3  boundary all n press shx ke
compute                                  4 pflux/grid all air momxy momxz momyz
compute 			5 eflux/grid all air heatx heaty heatz

stats_style	    step cpu np 

timestep 		                1.67e-9#3.34e-11#6e-10# 2.9394e-11#1.5e-9
run 			20000
fix			1 ave/grid all 1 100000 100000 c_1[*] c_2[*] #ave running
fix			2 ave/grid all 1 100000 100000 c_4[*]
fix				3 ave/time 1 100000 100000 c_3[*] ave running mode vector &
                  file   data/boundary_dsmc_couette.dat
fix			4 ave/grid all 1 100000 100000 c_5[*]

dump			1 grid all 100000 data/grid.*.dat id yc f_1[*]
dump			2 grid all 100000 data/pflux.*.dat id yc f_2[*]
dump			3 grid all 100000 data/eflux.*.dat id yc f_4[*]

run 			200000
