##############################################
#       Hypersonic flow around a cylinder, half domain
# Date        2025-05-26
# Abstract    MSP simulation, Ma=15, Kn=0.01, N2, VHS model
# Author      ziqicui
#             
##############################################

seed			    12345
dimension		    2
global			    gridcut -1.0 comm/sort yes

boundary		    o ro p
region              b1 block -0.1 0.12 0 0.1 INF INF
region              b2 block -0.075 0.075 0 0.075 INF INF

create_box		    -0.12 0.18 0 0.15 -0.5 0.5
#create_grid		    144 72 1 levels 3 region 2 b1 2 2 1 region 3 b2 2 2 1 #grid1
#create_grid		    72 36 1 levels 3 region 2 b1 2 2 1 region 3 b2 2 2 1  #grid2
create_grid		    36 18 1 levels 3 region 2 b1 2 2 1 region 3 b2 2 2 1	  #grid3
balance_grid		    rcb part

write_grid	    data/finalgrid.dat

global			    nrho 1.61e21 fnum 3.6225e13#fnum 7.245e12
fix				    10 balance 1000 1.1 rcb part
species			    N2.species N2
mixture			    air N2 vstream 4510 0.0 0.0 temp 217.5 trot 217.5 tvib 217.5

read_surf           circle.dat group 1
surf_collide		    1 diffuse 1000.0 1.0
surf_modify		    all collide 1

#MSPD:
collide				bgk air mspd N2.bgk 
collide_bgk_modify  time_ave 0.999 relax_mod 1 1 vib_energy discrete

collide_modify		rotate smooth vibrate discrete

#create_particles	air n 0
fix			       in emit/face air xlo xhi yhi 
#timestep		    2.4e-7
#timestep		    4.8e-7
timestep		    9.6e-7
stats			    100
stats_style		    step cpu np nscoll nscheck
run			    8000
compute			    1 grid all all u v n nrho massrho trot
fix 			    1 ave/grid all 1 8000 8000 c_1[*] ave running

compute			    2 thermal/grid all all temp press
fix			    2 ave/grid all 1 8000 8000 c_2[*] ave running


compute          3 tvib/grid all all
fix            3 ave/grid all 1 8000 8000 c_3[*] ave  running

dump 			    1 grid all 40000 data/gridw*.dat xc yc id f_1[*] f_2[*] f_3[*]
dump_modify		    1 format float %12.5g

compute 		    4 surf all all etot ke erot evib press shx shy nwt
fix			    4 ave/surf all 1 8000 8000 c_4[*] ave running
dump 			    4 surf all 40000 data/surfw*.dat id f_4[*]
dump_modify		    4 format float %12.5g

run			    32000

